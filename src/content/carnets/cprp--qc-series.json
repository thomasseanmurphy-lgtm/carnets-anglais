        },
        {
          "text": "\"I will inspect the whole batch.\" → She said she ___ inspect the whole batch.",
          "options": [
            "would",
            "will",
            "will be"
          ],
          "answer": "would"
        },
        {
          "text": "\"Record every measurement.\" → The supervisor told us ___ every measurement.",
          "options": [
            "to record",
            "record",
            "recording"
          ],
          "answer": "to record"
        },
        {
          "text": "\"The tool is worn.\" → He explained that the tool ___ worn.",
          "options": [
            "was",
            "is",
            "has"
          ],
          "answer": "was"
        },
        {
          "text": "\"Did you check the sample?\" → He asked me ___ I had checked the sample.",
          "options": [
            "if",
            "that",
            "did"
          ],
          "answer": "if"
        },
        {
          "text": "\"Don't accept a non-conforming part.\" → The foreman told the operator ___ accept a non-conforming part.",
          "options": [
            "not to",
            "to not",
            "don't"
          ],
          "answer": "not to"
        },
        {
          "text": "\"The batch passed the control.\" → The report stated that the batch ___ the control.",
          "options": [
            "had passed",
            "has passed",
            "passed"
          ],
          "answer": "had passed"
        }
